    "ingest:incremental": "node -e \"import('./agents/ingestAgent.js').then(m => m.runIncrementalSync())\"",
    "report:now": "node -e \"import('./agents/analystAgent.js').then(m => m.generateDailyReport().then(r => { console.log('Reporte generado:', r.fecha); process.exit(0); }))\"",
